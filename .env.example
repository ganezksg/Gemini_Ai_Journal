# GEMINI_SECRET_NAME: Optional Google Cloud Secret Manager resource identifier
# Format: projects/{PROJECT_ID}/secrets/{SECRET_NAME}/versions/{VERSION} or {SECRET_NAME}
# When configured, the backend retrieves the Gemini API credential directly from Secret Manager at runtime.
GEMINI_SECRET_NAME="gemini-api-key"

# GEMINI_API_KEY: Fallback server-side environment secret injected at runtime by Google AI Studio.
# Never exposed to client or browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Optional override for Firebase Admin verification project ID.
FIREBASE_PROJECT_ID="footnote-507318"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
