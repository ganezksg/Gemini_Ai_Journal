# GEMINI_SECRET_NAME: Optional Google Cloud Secret Manager resource identifier
# Format: projects/{PROJECT_ID}/secrets/{SECRET_NAME}/versions/{VERSION} or {SECRET_NAME}
# When configured, the backend retrieves the Gemini API credential directly from Secret Manager at runtime.
GEMINI_SECRET_NAME=""

# GEMINI_API_KEY: Server-side environment secret.
# Required if GEMINI_SECRET_NAME is not used. Never exposed to client or browser code.
GEMINI_API_KEY=""

# FIREBASE_PROJECT_ID: Optional override for Firebase Admin verification project ID.
FIREBASE_PROJECT_ID="footnote-507318"

# APP_URL: The URL where this app is hosted (e.g., http://localhost:3000 for local dev).
APP_URL="http://localhost:3000"
